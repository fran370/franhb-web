---
import { SITIO, NAVEGACION, SOCIAL } from '../consts';

interface Props {
  completa?: boolean;
}

const { completa = false } = Astro.props;

const linkedin = SOCIAL.find((s) => s.nombre === 'LinkedIn')?.url;
const x = SOCIAL.find((s) => s.nombre === 'X')?.url;
---

<header class="cabecera">
  <div class="cabecera__identidad">
    <img
      class="cabecera__foto"
      src={SITIO.foto}
      alt=""
      width="52"
      height="52"
      loading="eager"
    />
    <div>
      <p class="cabecera__nombre">
        <a href="/">{SITIO.nombre}</a>
      </p>
      <p class="cabecera__rol">
        <a href={`${SITIO.rolUrl}/?utm_source=web_personal_fran`}>{SITIO.rol}</a> · {SITIO.ciudad}
        <span class="cabecera__social">
          <a href={linkedin} aria-label="LinkedIn" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z"
              />
            </svg>
          </a>
          <a href={x} aria-label="X" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
              />
            </svg>
          </a>
        </span>
      </p>
    </div>
  </div>

  <nav class="cabecera__nav">
    {
      NAVEGACION.map((enlace) => (
        <a
          href={enlace.url}
          aria-current={Astro.url.pathname === enlace.url ? 'page' : undefined}
        >
          {enlace.nombre}
        </a>
      ))
    }
    <div class="cabecera__acciones">
      <a
        class="boton-icono"
        href="/"
        aria-label="Inicio"
        aria-current={Astro.url.pathname === '/' ? 'page' : undefined}
      >
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M3 11l9-8 9 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M5 10v10a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a
        class="boton-icono"
        href="/buscar/"
        aria-label="Buscar"
        aria-current={Astro.url.pathname === '/buscar/' ? 'page' : undefined}
      >
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
          <path d="M21 21l-4.35-4.35" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </a>
      <a class="boton-icono" href="/rss.xml" aria-label="Feed RSS">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="6" cy="18" r="1.6" fill="currentColor" />
          <path d="M5 11a8 8 0 0 1 8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path d="M5 5a14 14 0 0 1 14 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </a>
      <button
        id="cambiar-tema"
        class="boton-icono"
        type="button"
        aria-label="Cambiar entre modo claro y oscuro"
      >
        <svg class="icono-luna" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path
            d="M4 11.9309C4 16.9396 8.0596 21 13.0674 21C16.4803 21 19.4528 19.1141 21 16.3273C20.4852 16.4181 19.9554 16.4655 19.4145 16.4655C14.4068 16.4655 10.3472 12.4051 10.3472 7.39637C10.3472 5.80122 10.7589 4.30225 11.4819 3C7.23006 3.74996 4 7.46316 4 11.9309Z"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <svg class="icono-sol" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2" />
          <path
            d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  const boton = document.getElementById('cambiar-tema');
  boton?.addEventListener('click', () => {
    const actual = document.documentElement.getAttribute('data-tema');
    const nuevo = actual === 'oscuro' ? 'claro' : 'oscuro';
    document.documentElement.setAttribute('data-tema', nuevo);
    localStorage.setItem('tema', nuevo);
  });
</script>
