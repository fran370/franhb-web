---
import type { Page } from 'astro';
import Base from '../../../../layouts/Base.astro';
import Filtros from '../../../../components/Filtros.astro';
import Entrada from '../../../../components/Entrada.astro';
import Boletin from '../../../../components/Boletin.astro';
import Paginacion from '../../../../components/Paginacion.astro';
import { todasLasEntradas, temasDe, serieDe, type Entrada as TEntrada } from '../../../../utils/entradas';
import { TEMAS, LISTA_SERIES, SERIES, TAMANO_PAGINA, type Serie } from '../../../../consts';

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const entradas = await todasLasEntradas();
  return LISTA_SERIES.flatMap((serie) =>
    paginate(
      entradas.filter((e) => temasDe(e).includes(SERIES[serie].tema) && serieDe(e) === serie),
      {
        params: { tema: TEMAS[SERIES[serie].tema].ruta, serie: SERIES[serie].ruta },
        props: { clave: serie },
        pageSize: TAMANO_PAGINA,
      }
    )
  );
}

const { page, clave } = Astro.props as { page: Page<TEntrada>; clave: Serie };
const info = SERIES[clave];
const titulo = page.currentPage > 1 ? `${info.etiqueta} · página ${page.currentPage}` : info.etiqueta;
---

<Base titulo={titulo} cabeceraCompleta={false}>
  <Filtros />
  <div class="cinta">
    {page.data.map((entrada, i) => <Entrada entrada={entrada} orden={i} />)}
  </div>
  <Paginacion
    actual={page.currentPage}
    total={page.lastPage}
    anterior={page.url.prev}
    siguiente={page.url.next}
  />
  {page.currentPage === 1 && (clave === 'ma-weekly' ? <Boletin /> : <Boletin tipo="novedades" />)}
</Base>
